# Copy to backend/.env (gitignored) and fill in the values.

# Local Postgres from docker compose. Rails adds the database name
# (app_development) from config/database.yml.
DATABASE_URL=postgres://postgres:postgres@db:5432

# Prices include this tax rate (0.15 = 15%).
TAX_RATE=0.15

# Clerk keys (Dashboard -> API keys). The publishable key is the same one the frontend uses.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Shared secret that authenticates the SII webhook (e.g. `openssl rand -hex 24`).
SII_WEBHOOK_TOKEN=change-me

# Public URL of this API so the SII can call the webhook. Leave empty when running
# locally: receipts are created normally but stay "pending".
SII_CALLBACK_URL=
